# After `npx expo prebuild -p ios`, copy this into the native project:
#
#   cp xcode.env.local.example ios/.xcode.env.local
#
# Xcode sources `.xcode.env.local` for script phases (bundler, etc.).

# Pin Metro port so the native app and `expo start --port 8081` always agree.
export RCT_METRO_PORT=8081

# Use a stable Node (Expo recommends LTS). Homebrew example:
# export NODE_BINARY=/opt/homebrew/opt/node@20/bin/node
